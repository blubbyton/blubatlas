-- atlas by blub
-- Apply branding before the startup guard, including an already-running window.
do
	local titleText = "atlas by blub"
	local connections = _G.AtlasTitleConnections
	if type(connections) == "table" then
		for _, connection in pairs(connections) do
			pcall(function() connection:Disconnect() end)
		end
	end
	connections = {}
	_G.AtlasTitleConnections = connections
	local watched = {}
	local roots = {}

	local function updateTitle(label)
		if not (label:IsA("TextLabel") or label:IsA("TextButton")) then return end
		local text = string.lower(label.Text)
		if not string.find(text, "atlas", 1, true) or not string.find(text, "by", 1, true) then return end
		if label.Name ~= "Title" and not (label.Parent and label.Parent.Name == "Bar") then return end
		label.Text = titleText
		if watched[label] then return end
		watched[label] = true
		table.insert(connections, label:GetPropertyChangedSignal("Text"):Connect(function()
			if label.Text ~= titleText then label.Text = titleText end
		end))
	end

	local function watchRoot(root)
		if typeof(root) ~= "Instance" or roots[root] then return end
		roots[root] = true
		for _, child in ipairs(root:GetDescendants()) do updateTitle(child) end
		table.insert(connections, root.DescendantAdded:Connect(function(child)
			task.defer(function() pcall(updateTitle, child) end)
		end))
	end

	pcall(function() watchRoot(_G.atlas) end)
	pcall(function() if gethui then watchRoot(gethui()) end end)
	pcall(function() watchRoot(game:GetService("CoreGui")) end)
	pcall(function()
		local player = game:GetService("Players").LocalPlayer
		if player then watchRoot(player:FindFirstChildOfClass("PlayerGui")) end
	end)
end

if _G.loading then return end
_G.loading = true
